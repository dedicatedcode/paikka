# =============================================================================
# PAIKKA sample environment configuration
#
# Copy this file to `.env` in the repository root and fill in the values:
#
#   cp env.sample .env
#
# This sample covers the update/import pipeline scripts:
#   - scripts/update.sh
#   - scripts/update-h3.sh
#
# Runtime service variables such as ADMIN_PASSWORD, BASE_URL, MAX_RESULTS, etc.
# are documented in README.md.
#
# Required / optional markers used below:
#   REQUIRED          the script exits when this value is missing
#   CONDITIONAL       only required when the related feature is enabled
#   Optional          has a default or may be left empty
#
# Loading behaviour:
#   - scripts/update.sh        sources `.env` from its working directory
#   - scripts/update-h3.sh     sources `.env` from its working directory by default,
#                              or the file given via --env-file
#
# Command-line flags override values from .env. NEVER commit a filled-in .env
# (`.env` is gitignored).
# =============================================================================

# -----------------------------------------------------------------------------
# Shared import settings (used by scripts/update.sh and scripts/update-h3.sh)
# -----------------------------------------------------------------------------
# Optional: where downloaded PBF files and intermediate files are kept.
# Default: current working directory.
DOWNLOAD_DIR=""

# Optional: JVM heap size for import processes.
# Default: 16G (update.sh) / 16g (update-h3.sh).
IMPORT_MEMORY="16G"

# Optional: number of import threads.
# Default: 10.
IMPORT_THREADS="10"

# Optional: use a local PBF file instead of downloading the planet file.
# Same as the --pbf-file flag. Leave empty to download.
PBF_INPUT_PATH=""

# --- Advanced overrides (rarely needed, both pipelines) ---
# Optional: planet download URL.
# Default: https://planet.osm.org/pbf/planet-latest.osm.pbf
#PLANET_URL="https://planet.osm.org/pbf/planet-latest.osm.pbf"
# Optional: Docker image used for filtering/importing.
# Default: dedicatedcode/paikka:latest
#DOCKER_IMAGE="dedicatedcode/paikka:latest"

# -----------------------------------------------------------------------------
# OSM import pipeline (scripts/update.sh)
# -----------------------------------------------------------------------------

# REQUIRED (or pass --remote-user, --remote-host, --api-token):
# deployment target and its admin API token.
REMOTE_USER=""
REMOTE_HOST=""
GEOCODER_API_TOKEN=""

# Optional: where the update.sh import bundle is built.
# Default: ./import
IMPORT_DATA_DIR=""

# --- Cloudflare cache invalidation (optional) ---
# Optional: enable via --purge-cache or PURGE_CLOUDFLARE_CACHE=true.
# Default: false
PURGE_CLOUDFLARE_CACHE="false"
# CONDITIONAL: required when PURGE_CLOUDFLARE_CACHE=true.
# Token with "Zone.Cache Purge" permission.
CLOUDFLARE_API_TOKEN=""
# CONDITIONAL: required when PURGE_CLOUDFLARE_CACHE=true.
CLOUDFLARE_ZONE_ID=""
# Optional: comma-separated list of exact https:// URLs to purge instead of
# the entire zone cache (at most 30 URLs per request).
CLOUDFLARE_PURGE_PATTERN=""

# --- GitHub import statistics (optional, see issue #63) ---
# Optional: enable via --post-stats or POST_IMPORT_STATS=true.
# Default: false
POST_IMPORT_STATS="false"
# CONDITIONAL: required when POST_IMPORT_STATS=true.
# Fine-grained GitHub token with "Discussions: Read & write" permission
# for the repository below.
GITHUB_TOKEN=""
# CONDITIONAL: required when POST_IMPORT_STATS=true.
# Number of the discussion that receives one comment per successful import
# (taken from the discussion URL: github.com/OWNER/REPO/discussions/NUMBER).
GH_DISCUSSION_NUMBER=""
# Optional: repository that receives the statistics comment.
# Default: dedicatedcode/paikka
# Only needs changing when posting from a fork.
GH_STATS_REPO="dedicatedcode/paikka"

# -----------------------------------------------------------------------------
# Boundaries / H3 pipeline (scripts/update-h3.sh -> import-boundaries.sh,
# create-h3-bundle.sh, upload-h3-bundle.sh)
# -----------------------------------------------------------------------------

# Optional: where the boundary data and bundles are built.
# Default: current working directory.
DATA_DIR=""

# Optional: version tag for the created bundle.
# Default: YYYY-MM-DD-v1
VERSION=""

# Optional: base URL under which the bundle will be published.
# Default: https://h3-osm.dedicatedcode.com
DOWNLOAD_BASE_URL="https://h3-osm.dedicatedcode.com"

# Optional: local output directory for the bundle.
# Default: ./dist
BUNDLE_OUTPUT_DIR=""

# --- R2 upload credentials (scripts/update-h3.sh / scripts/upload-h3-bundle.sh) ---
# REQUIRED unless the upload is skipped with --no-upload or NO_UPLOAD=true.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional: subfolder inside the bucket.
# Leave empty for the bucket root.
R2_PATH=""
# Optional: skip the R2 upload (same as --no-upload).
# Default: false
NO_UPLOAD="false"
